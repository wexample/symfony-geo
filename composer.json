{
  "name": "wexample/symfony-geo",
  "description": "Geo helpers for Symfony",
  "type": "library",
  "license": "MIT",
  "version": "2.0.0",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyGeo\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "wexample/symfony-helpers": ">=5.0.0",
    "wexample/symfony-api": ">=3.0.0",
    "wexample/symfony-money": ">=2.0.0",
    "rinvex/countries": "^8.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ]
}