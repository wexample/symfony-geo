{
  "name": "wexample/symfony-geo",
  "description": "Geo helpers for Symfony",
  "type": "library",
  "license": "MIT",
  "version": "3.1.2",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyGeo\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=10.0.0",
    "wexample/symfony-api": ">=6.0.0",
    "wexample/symfony-money": ">=4.0.0",
    "rinvex/countries": "^8.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}